@model List<TypingTest.ViewModels.TestResultViewModel>
@{
    ViewData["Title"] = "Test History";
}

<div style="max-width:900px; margin:2rem auto;">

    <div class="page-title">◷ Test History</div>
    <div class="page-subtitle">// all your completed tests</div>

    @if (!Model.Any())
    {
        <div class="card" style="text-align:center; padding:3rem;">
            <div style="font-family:var(--font-mono); color:var(--text3); margin-bottom:1rem;">
                No tests yet. Start typing!
            </div>
            <a asp-controller="Test" asp-action="Index" class="btn btn-primary">▶ Start Test</a>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>WPM</th>
                        <th>Accuracy</th>
                        <th>Errors</th>
                        <th>Difficulty</th>
                        <th>Mode</th>
                        <th>Passage</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>
                                <span style="font-family:var(--font-display); font-size:1.1rem; color:var(--accent); font-weight:700;">
                                    @r.Wpm
                                </span>
                            </td>
                            <td style="color:var(--success)">@r.AccuracyDisplay</td>
                            <td style="color:var(--danger)">@r.ErrorCount</td>
                            <td>
                                <span class="badge @(r.Difficulty == TypingTest.Models.DifficultyLevel.Easy ? "badge-easy" : r.Difficulty == TypingTest.Models.DifficultyLevel.Medium ? "badge-medium" : "badge-hard")">
                                    @r.Difficulty
                                </span>
                            </td>
                            <td>
                                <span class="badge @(r.Mode == TypingTest.Models.TestMode.Timed ? "badge-timed" : "badge-words")">
                                    @r.Mode
                                </span>
                            </td>
                            <td style="color:var(--text2); font-size:0.8rem;">@r.PassageTitle</td>
                            <td style="color:var(--text3); font-size:0.8rem;">
                                @r.CompletedAt.ToString("MMM dd, yyyy HH:mm")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div style="text-align:center; margin-top:1.5rem;">
            <a asp-controller="Test" asp-action="Index" class="btn btn-primary">▶ Play Again</a>
        </div>
    }
</div>