            m: ["mirth","mist","moan","moat","mock","mode","molt","monk","mope","moss","muck","mule","mull","murk","muse","musk","march","marsh","mason","match","maxim","media","mercy","merge","merit","metal","meter","might","mimic","mince","minor","minus","model","money","month","moral","mount","mucus","muddy","musty","mystic"],
            n: ["nerve","nest","newt","nick","node","norm","notch","nudge","null","numb","nadir","naive","nasal","naval","needy","nexus","night","ninja","noble","noise","noose","north","novel","nylon"],
            o: ["orbit","omen","ooze","oval","oven","oath","oboe","odds","once","only","open","opus","orca","oral","order","other","ought","outer","overt","oxide","ozone"],
            p: ["prism","plod","plot","plow","plug","plus","polo","pond","pore","port","pose","pour","pout","prey","prod","prop","prose","prowl","pull","pump","pure","plank","plane","plant","plate","plead","press","price","pride","prime","print","probe","prone","proof","proud","prove","prune","punch","pupil","purge"],
            q: ["quaff","qualm","quash","queen","query","quest","queue","quill","quirk","quota","quote","quake","quart","quite"],
            r: ["ridge","rift","ring","rink","riot","risk","rite","roam","roar","robe","rock","rogue","role","roll","romp","rook","root","rope","rose","rove","ruin","rule","rung","rush","rust","raze","ream","reap","reed","reef","reel","rein","rely","rend","rent","rest","revel","rider","ripen","rivet","round","rouse","route","rowdy","royal","ruddy","ruler","rural"],
            s: ["swift","swam","swat","sway","syrup","sage","sail","sake","sale","sand","sane","save","scan","scar","scope","score","scout","seam","sect","seed","seep","self","send","shed","shin","shoe","shone","shook","shout","shove","shore","short","silk","silt","sire","size","skew","skid","skim","skin","skit","slap","slash","slim","slip","slug","slur","small","smash","smear","smoke","snail","snare","sniff","snore","solar","solve","stark","stern","stomp","stone","store","storm","style","surge","swarm","sweep"],
            t: ["throb","thud","thug","tilt","time","toil","toll","tomb","tone","tool","tore","torn","toss","tote","tour","town","trace","track","trail","trait","tramp","trash","tread","treat","trend","trick","trim","trip","trot","true","trunk","trust","truth","tulip","tunic","turbo","tweak","twice","twist","tacit","taint","tally","talon","taper","taste","taunt","teach","tense","theft","thick","thing","think","thorn","three","throw","thumb","thump","title","touch","tough","towel","trial"],
            u: ["ultra","undo","unit","urge","utter","ulcer","uncle","under","union","unite","unity","until","upper","upset","urban","usage","usher","usual","usurp"],
            v: ["vivid","vale","vane","vast","vent","verb","vest","veto","vice","vile","vine","void","vote","valor","valve","vault","verge","verse","vigil","vigor","visor","vixen","vocal","voter","vulgar"],
            w: ["wreck","writ","wane","ward","warn","warp","wary","wasp","wave","weld","well","whet","whim","whiz","wick","wide","wild","wile","wilt","wind","wine","wing","wink","wire","wise","wish","wisp","wolf","word","wore","work","worm","worn","wrap","wrath","wring","wrist","wrong"],
            x: ["xenon","xeric"],
            y: ["yearn","yield","young","yours","yodel","yummy","yacht","yawl","yelp"],
            z: ["zebra","zeal","zero","zest","zinc","zone","zoom","zany","zilch","zippy"]
        };

        // ── Game State ────────────────────────────────────────────────────────────
        const MAX_LIVES  = 3;
        const TRAIL_MAX  = 6;
        const WORD_BEATS = 4;

        let lives, score, chain, bestChain, wordsChained, bestWpm, perfectHits;
        let currentRequiredLetter;
        let currentTargetWord;
        let wordStartTime;
        let wordBeatTimer;
        let totalCharsTyped, totalTimeMs;
        let gameActive = false;
        let beatMs;
        let trailWords = [];
        let beatBarFrame = null;
        let beatBarStart = null;
        let beatBarDuration = 0;

        // ── Helpers ───────────────────────────────────────────────────────────────
        function toggleMute() {
            const muted = ChainAudio.toggleMute();
            document.getElementById('mute-btn').textContent = muted ? '🔇' : '🔊';
        }

        function getWordsFor(letter) {
            return DICT[letter.toLowerCase()] ?? DICT['a'];
        }

        function lastLetter(word) {
            return word[word.length - 1].toLowerCase();
        }

        function randomStartLetter() {
            const letters = ['a','b','c','d','e','f','g','h','m','p','s','t','w'];
            return letters[Math.floor(Math.random() * letters.length)];
        }

        function pickWord(letter) {
            const pool = getWordsFor(letter);
            return pool[Math.floor(Math.random() * pool.length)];
        }

        // ── Lives ─────────────────────────────────────────────────────────────────
        function initLives() {
            const el = document.getElementById('lives-display');
            el.innerHTML = '';
            for (let i = 0; i < MAX_LIVES; i++) {
                const dot = document.createElement('div');
                dot.className = 'chain-life';
                dot.id = 'life-' + i;
                el.appendChild(dot);
            }
        }

        function updateLives() {
            for (let i = 0; i < MAX_LIVES; i++) {
                document.getElementById('life-' + i)
                        .classList.toggle('lost', i >= lives);
            }
        }

        // ── HUD ───────────────────────────────────────────────────────────────────
        function updateHud() {
            document.getElementById('hud-score').textContent = score;
            document.getElementById('hud-chain').textContent = chain;
            document.getElementById('hud-bpm').textContent =
                typeof ChainAudio !== 'undefined' ? ChainAudio.bpmForChain(chain) : 80;

            const wpm = totalTimeMs > 0
                ? Math.round((totalCharsTyped / 5) / (totalTimeMs / 60000))
                : 0;
            if (wpm > bestWpm) bestWpm = wpm;
            document.getElementById('hud-wpm').textContent = wpm;
        }

        // ── Trail ─────────────────────────────────────────────────────────────────
        function addToTrail(word) {
            trailWords.push(word);
            if (trailWords.length > TRAIL_MAX) trailWords.shift();

            const el = document.getElementById('chain-trail');
            el.innerHTML = '';
            trailWords.forEach((w, i) => {
                if (i > 0) {
                    const arrow = document.createElement('span');
                    arrow.className = 'chain-arrow';
                    arrow.textContent = '→';
                    el.appendChild(arrow);
                }
                const span = document.createElement('span');
                span.className = 'chain-word' + (i === trailWords.length - 1 ? ' recent' : '');
                span.textContent = w.toUpperCase();
                el.appendChild(span);
            });
        }

        // ── Feedback ──────────────────────────────────────────────────────────────
        function showFeedback(type, text) {
            const el = document.getElementById('feedback');
            el.textContent = text;
            el.className = 'chain-feedback show ' + type;
            clearTimeout(el._timer);
            el._timer = setTimeout(() => el.classList.remove('show'), 900);
        }

        // ── Beat Bar ──────────────────────────────────────────────────────────────
        function startBeatBar(duration) {
            beatBarDuration = duration;
            beatBarStart    = performance.now();
            cancelAnimationFrame(beatBarFrame);

            function animate() {
                const elapsed   = performance.now() - beatBarStart;
                const remaining = Math.max(0, 1 - elapsed / beatBarDuration);
                const bar       = document.getElementById('beat-bar');
                if (bar) {
                    bar.style.width = (remaining * 100) + '%';
                    if (remaining > 0.5)      bar.style.background = '#00e5ff';
                    else if (remaining > 0.2) bar.style.background = '#ffd600';
                    else                      bar.style.background = '#ff4466';
                }
                if (remaining > 0 && gameActive) {
                    beatBarFrame = requestAnimationFrame(animate);
                }
            }
            beatBarFrame = requestAnimationFrame(animate);
        }

        // ── Arena Beat Pulse ──────────────────────────────────────────────────────
        function onBeat() {
            const arena = document.getElementById('chain-arena');
            if (!arena || !gameActive) return;
            arena.classList.remove('beat-pulse');
            void arena.offsetWidth;
            arena.classList.add('beat-pulse');
        }

        // ── Next Round ────────────────────────────────────────────────────────────
        function nextRound(requiredLetter) {
            if (!gameActive) return;

            clearTimeout(wordBeatTimer);
            cancelAnimationFrame(beatBarFrame);

            currentRequiredLetter = requiredLetter ?? randomStartLetter();
            currentTargetWord     = pickWord(currentRequiredLetter);

            document.getElementById('chain-prompt').textContent = 'type this word';
            document.getElementById('target-word').textContent  = currentTargetWord.toUpperCase();

            const hint = document.getElementById('last-hint');
            if (trailWords.length > 0) {
                const prev = trailWords[trailWords.length - 1];
                hint.innerHTML = `ends with <span>${lastLetter(prev).toUpperCase()}</span> → starts with <span>${currentRequiredLetter.toUpperCase()}</span>`;
            } else {
                hint.innerHTML = '';
            }

            document.getElementById('chain-input').value = '';
            document.getElementById('chain-input').className = 'chain-input';

            wordStartTime = performance.now();
            beatMs = ChainAudio.beatIntervalMs();
            if (!beatMs || beatMs <= 0 || isNaN(beatMs)) beatMs = 750;

            const windowMs = beatMs * WORD_BEATS;
            startBeatBar(windowMs);

            wordBeatTimer = setTimeout(() => {
                if (gameActive) missRound('⏱ Too slow!');
            }, windowMs);
        }

        // ── Miss Round ────────────────────────────────────────────────────────────
        function missRound(reason = 'MISS') {
            lives--;
            chain = 0;
            updateLives();
            showFeedback('miss', reason);
            ChainAudio.playMiss();
            ChainAudio.updateBpm(0);
            document.getElementById('chain-input').value = '';

            if (lives <= 0) {
                endGame();
            } else {
                setTimeout(() => nextRound(randomStartLetter()), 900);
            }
        }

        // ── Submit Word ───────────────────────────────────────────────────────────
        function submitWord() {
            if (!gameActive || !currentTargetWord) return;

            const input = document.getElementById('chain-input');
            const typed = input.value.trim().toLowerCase();

            if (!typed) return;

            if (typed !== currentTargetWord.toLowerCase()) {
                showFeedback('wrong', `Type "${currentTargetWord.toUpperCase()}"`);
                input.classList.add('invalid');
                setTimeout(() => input.classList.remove('invalid'), 300);
                return;
            }

            clearTimeout(wordBeatTimer);
            cancelAnimationFrame(beatBarFrame);

            const timing     = ChainAudio.judgeTiming();
            const reactionMs = performance.now() - wordStartTime;

            totalCharsTyped += typed.length;
            totalTimeMs     += reactionMs;

            const basePoints  = typed.length * 10;
            const chainBonus  = chain * 3;
            const timingBonus = { perfect: 20, good: 10, late: 3, miss: 0 }[timing] ?? 0;
            const gained      = basePoints + chainBonus + timingBonus;

            score += gained;
            chain++;
            wordsChained++;
            if (chain > bestChain) bestChain = chain;
            if (timing === 'perfect') perfectHits++;

            const feedbackMap = {
                perfect: `🎯 PERFECT +${gained}`,
                good:    `✅ GOOD +${gained}`,
                late:    `⚡ LATE +${gained}`,
                miss:    `+${gained}`
            };
            showFeedback(timing, feedbackMap[timing]);

            ChainAudio.playHit(timing);
            ChainAudio.updateBpm(chain);
            addToTrail(typed);
            updateHud();

            const next = lastLetter(typed);
            setTimeout(() => nextRound(next), 400);
        }

        // ── End Game ──────────────────────────────────────────────────────────────
        function endGame() {
            gameActive = false;
            clearTimeout(wordBeatTimer);
            cancelAnimationFrame(beatBarFrame);

            ChainAudio.stop();
            ChainAudio.playGameOver();

            document.getElementById('game-screen').style.display    = 'none';
            document.getElementById('gameover-screen').style.display = 'flex';

            document.getElementById('go-score').textContent    = score;
            document.getElementById('go-chain').textContent    = bestChain;
            document.getElementById('go-wpm').textContent      = bestWpm;
            document.getElementById('go-words').textContent    = wordsChained;
            document.getElementById('go-perfects').textContent = perfectHits;

            saveScore();
        }

        // ── Save Score ────────────────────────────────────────────────────────────
                async function saveScore() {
            const indicator = document.getElementById('saving-indicator');
            indicator.textContent = 'Saving...';
            indicator.className   = 'saving-indicator';

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

                const res = await fetch('/ChainMode/SaveScore', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        score:        score,
                        bestChain:    bestChain,
                        wordsChained: wordsChained,
                        bestWpm:      bestWpm,
                        perfectHits:  perfectHits
                    })
                });

                if (res.ok) {
                    const data = await res.json();
                    indicator.textContent = '✓ Saved';
                    indicator.className   = 'saving-indicator saved';
                    showHighScoreBanner(data.isNewHighScore, data.previousBest, data.currentScore);
                } else {
                    throw new Error();
                }
            } catch {
                indicator.textContent = '✗ Could not save';
                indicator.className   = 'saving-indicator error';
            }
        }

        function showHighScoreBanner(isNew, previousBest, currentScore) {
            const banner = document.getElementById('highscore-banner');
            const title  = document.getElementById('hs-title');
            const sub    = document.getElementById('hs-sub');

            if (isNew) {
                banner.className = 'hs-banner hs-new';
                title.textContent = '🏆 New High Score!';
                sub.textContent   = previousBest > 0
                    ? `Previous best: ${previousBest.toLocaleString()} — you beat it!`
                    : 'First score on the board!';
            } else if (previousBest > 0) {
                banner.className = 'hs-banner hs-existing';
                title.textContent = `🏆 Best: ${previousBest.toLocaleString()} pts`;
                sub.textContent   = `${(previousBest - currentScore + 1).toLocaleString()} more needed to beat your record`;
            } else {
                banner.className = 'hs-banner hs-existing';
                title.textContent = '🏆 Score Saved!';
                sub.textContent   = 'Play again to set a record';
            }

            banner.style.display = 'flex';
        }

        // ── Start Game ────────────────────────────────────────────────────────────
        function startGame() {
            lives           = MAX_LIVES;
            score           = 0;
            chain           = 0;
            bestChain       = 0;
            wordsChained    = 0;
            bestWpm         = 0;
            perfectHits     = 0;
            totalCharsTyped = 0;
            totalTimeMs     = 0;
            trailWords      = [];
            gameActive      = true;
            currentTargetWord = null;

            document.getElementById('game-screen').style.display    = 'flex';
            document.getElementById('gameover-screen').style.display = 'none';
            document.getElementById('chain-trail').innerHTML        = '';
            document.getElementById('chain-input').value           = '';
            document.getElementById('target-word').textContent     = '—';
            document.getElementById('last-hint').innerHTML         = '';
            document.getElementById('feedback').className          = 'chain-feedback';

            initLives();
            updateHud();
        }

        // ── Handle Start ──────────────────────────────────────────────────────────
        function handleStart() {
            const overlay = document.getElementById('start-overlay');
            if (overlay) overlay.style.display = 'none';

            ChainAudio.playStart();
            ChainAudio.start(0, onBeat);

            document.getElementById('chain-input').focus();
            setTimeout(() => nextRound(randomStartLetter()), 800);
        }

        // ── Restart Game ──────────────────────────────────────────────────────────
        function restartGame() {
            ChainAudio.stop();
            startGame();
            const overlay = document.getElementById('start-overlay');
            if (overlay) overlay.style.display = 'flex';
        }

        // ── Input Listeners ───────────────────────────────────────────────────────
        document.getElementById('chain-input').addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                submitWord();
            }
        });

        document.getElementById('chain-input').addEventListener('input', function () {
            if (!gameActive || !currentTargetWord) return;

            const typed  = this.value.trim().toLowerCase();
            const target = currentTargetWord.toLowerCase();

            if (!typed) {
                this.className = 'chain-input';
                return;
            }

            this.className = 'chain-input ' + (target.startsWith(typed) ? 'valid' : 'invalid');
        });

        // ── Init ──────────────────────────────────────────────────────────────────
        startGame();
    </script>
}