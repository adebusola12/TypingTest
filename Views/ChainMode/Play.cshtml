@{
    ViewData["Title"] = "Chain Mode";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ── Full screen rhythmic feel ───────────────────────────────────────── */
    * {
        box-sizing: border-box;
    }

    .chain-wrap {
        position: fixed;
        inset: 0;
        top: 56px;
        background: #0a0a1a;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-family: monospace;
        overflow: hidden;
    }
    H
        .chain-wrap::before {
            content: '';
            position: fixed;
            inset: 0;
            background: radial-gradient(ellipse 60% 50% at 50% 50%, rgba(0, 229, 255, 0.06) 0%, transparent 70%);
            pointer-events: none;
            z-index: 0;
        }

    /* ── HUD ─────────────────────────────────────────────────────────────── */
    .chain-hud {
        position: fixed;
        top: 64px;
        left: 0;
        right: 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem 2rem;
        background: rgba(10, 6, 15, 0.9);
        border-bottom: 1px solid rgba(0, 229, 255, 0.15);
        z-index: 10;
    }

    .hud-group {
        display: flex;
        gap: 2rem;
        align-items: center;
    }

    .hud-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
    }

    .hud-label {
        font-size: 0.6rem;
        color: #334455;
        letter-spacing: 0.2em;
        text-transform: uppercase;
    }

    .hud-value {
        font-size: 1.1rem;
        font-weight: 700;
        color: #00e5ff;
    }

    /* ── Lives — gem style ───────────────────────────────────────────────── */
    .chain-lives {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .chain-life {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #00e5ff;
        box-shadow: 0 0 8px rgba(0, 229, 255, 0.6);
        transition: all 0.3s;
    }

        .chain-life.lost {
            background: #1a0a2a;
            box-shadow: none;
        }

    /* ── Chain trail ─────────────────────────────────────────────────────── */
    .chain-trail {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: center;
        max-width: 560px;
        min-height: 24px;
        margin-bottom: 1.5rem;
        align-items: center;
        z-index: 1;
    }

    .chain-word {
        font-size: 0.7rem;
        color: #1a2233;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        transition: color 0.3s;
    }

        .chain-word.recent {
            color: #00e5ff;
            text-shadow: 0 0 8px rgba(0, 229, 255, 0.4);
        }

    .chain-arrow {
        font-size: 0.6rem;
        color: #1a2233;
    }

    /* ── Arena ───────────────────────────────────────────────────────────── */
    .chain-arena {
        position: relative;
        width: 380px;
        height: 220px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: rgba(0, 229, 255, 0.04);
        border: 1px solid rgba(0, 229, 255, 0.2);
        border-radius: 16px;
        margin-bottom: 1.5rem;
        overflow: hidden;
        z-index: 1;
    }

        /* Animated corner accents */
        .chain-arena::before,
        .chain-arena::after {
            content: '';
            position: absolute;
            width: 20px;
            height: 20px;
            border-color: rgba(0, 229, 255, 0.5);
            border-style: solid;
        }

        .chain-arena::before {
            top: 8px;
            left: 8px;
            border-width: 2px 0 0 2px;
            border-radius: 4px 0 0 0;
        }

        .chain-arena::after {
            bottom: 8px;
            right: 8px;
            border-width: 0 2px 2px 0;
            border-radius: 0 0 4px 0;
        }

        /* Beat pulse glow */
        .chain-arena.beat-pulse {
            animation: chainPulse 0.15s ease-out;
        }

    @@keyframes chainPulse {
        0% {
            box-shadow: 0 0 0 0 rgba(180,79,255,0.4), inset 0 0 20px rgba(180,79,255,0.1);
        }

        50% {
            box-shadow: 0 0 0 12px rgba(180,79,255,0), inset 0 0 30px rgba(180,79,255,0.08);
        }

        100% {
            box-shadow: none;
        }
    }

    .chain-prompt {
        font-size: 0.6rem;
        color: #334455;
        text-transform: uppercase;
        letter-spacing: 0.25em;
        margin-bottom: 0.5rem;
    }

    .chain-target-word {
        font-size: clamp(2rem, 5vw, 2.8rem);
        font-weight: 700;
        color: #00e5ff;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        user-select: none;
        text-shadow: 0 0 20px rgba(0, 229, 255, 0.5), 0 0 40px rgba(0, 229, 255, 0.2);
    }

    .chain-last-hint {
        font-size: 0.65rem;
        color: #334455;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        margin-top: 0.5rem;
    }

        .chain-last-hint span {
            color: #00e5ff;
        }

    /* Beat bar */
    .beat-bar-track {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: #0a0a1a;
    }

    .beat-bar-fill {
        height: 100%;
        background: #00e5ff;
        width: 100%;
        transition: none;
        box-shadow: 0 0 8px rgba(0, 229, 255, 0.6);
    }

    /* ── Timing zones ────────────────────────────────────────────────────── */
    .timing-zones {
        display: flex;
        gap: 6px;
        margin-bottom: 1.2rem;
        font-size: 0.6rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        z-index: 1;
    }

    .zone {
        padding: 3px 10px;
        border-radius: 3px;
        font-weight: 700;
    }

    .zone-perfect {
        background: rgba(0,255,136,0.08);
        color: #00ff88;
        border: 1px solid rgba(0,255,136,0.3);
    }

    .zone-good {
        background: rgba(255,214,0,0.08);
        color: #ffd600;
        border: 1px solid rgba(255,214,0,0.3);
    }

    .zone-late {
        background: rgba(255,100,0,0.08);
        color: #ff6400;
        border: 1px solid rgba(255,100,0,0.3);
    }

    /* ── Input ───────────────────────────────────────────────────────────── */
    .chain-input {
        background: rgba(0, 229, 255, 0.04);
        border: 1px solid rgba(0, 229, 255, 0.2);
        border-radius: 8px;
        color: #00e5ff;
        font-family: monospace;
        font-size: 1.3rem;
        text-align: center;
        padding: 0.75rem 1.5rem;
        width: 320px;
        outline: none;
        letter-spacing: 0.1em;
        transition: border-color 0.15s, box-shadow 0.15s;
        caret-color: #00e5ff;
        z-index: 1;
    }

        .chain-input:focus {
            border-color: rgba(0, 229, 255, 0.5);
            box-shadow: 0 0 20px rgba(0, 229, 255, 0.1);
        }

        .chain-input.valid {
            border-color: #00ff88;
            color: #00ff88;
            box-shadow: 0 0 15px rgba(0, 255, 136, 0.1);
        }

        .chain-input.invalid {
            border-color: rgba(0, 229, 255, 0.5);
            color: #ff4466;
        }

    /* ── Feedback ────────────────────────────────────────────────────────── */
    .chain-feedback {
        margin-top: 0.75rem;
        font-size: 1rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        min-height: 24px;
        opacity: 0;
        transition: opacity 0.15s;
        z-index: 1;
    }

        .chain-feedback.show {
            opacity: 1;
        }

        .chain-feedback.perfect {
            color: #00ff88;
            text-shadow: 0 0 10px rgba(0,255,136,0.4);
        }

        .chain-feedback.good {
            color: #ffd600;
        }

        .chain-feedback.late {
            color: #ff6400;
        }

        .chain-feedback.miss {
            color: #ff4466;
        }

        .chain-feedback.wrong {
            color: #ff4466;
        }

    /* ── Mute button ─────────────────────────────────────────────────────── */
    #mute-btn {
        background: none;
        border: 1px solid rgba(0, 229, 255, 0.2);
        border-radius: 4px;
        color: #445566;
        font-family: monospace;
        font-size: 0.75rem;
        padding: 0.25rem 0.6rem;
        cursor: pointer;
    }

    /* ── Start Overlay ───────────────────────────────────────────────────── */
    .start-overlay {
        position: fixed;
        inset: 0;
        background: rgba(10, 6, 15, 0.97);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        z-index: 100;
        cursor: pointer;
        text-align: center;
        padding: 2rem;
    }

    .start-overlay-title {
        font-family: monospace;
        font-size: clamp(2rem, 8vw, 3.5rem);
        font-weight: 700;
        color: #00e5ff;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 0.5rem;
        text-shadow: 0 0 40px rgba(0, 229, 255, 0.4);
    }

    .start-overlay-sub {
        font-family: monospace;
        font-size: 0.8rem;
        color: #445566;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        margin-bottom: 2.5rem;
    }

    .start-overlay-rules {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-bottom: 2rem;
        text-align: left;
        max-width: 400px;
        width: 100%;
        background: rgba(0, 229, 255, 0.04);
        border: 1px solid rgba(0, 229, 255, 0.15);
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
    }

    .start-overlay-rule {
        font-family: monospace;
        font-size: 0.82rem;
        color: #667788;
        line-height: 1.5;
    }

        .start-overlay-rule span {
            color: #00e5ff;
        }

    .start-overlay-example {
        font-family: monospace;
        font-size: 0.78rem;
        color: #334455;
        margin-bottom: 2rem;
        letter-spacing: 0.05em;
    }

        .start-overlay-example span {
            color: #00e5ff;
        }

    .start-overlay-btn {
        background: #00e5ff;
        color: #000;
        font-family: monospace;
        font-size: 1rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        padding: 1rem 3rem;
        border-radius: 8px;
        border: none;
        cursor: pointer;
       
        box-shadow: 0 0 30px rgba(0, 229, 255, 0.3);
        transition: box-shadow 0.2s, transform 0.2s;
    }

        .start-overlay-btn:hover {
            box-shadow: 0 0 40px rgba(0, 229, 255, 0.5);
            transform: translateY(-2px);
        }

    /* ── Game Over ───────────────────────────────────────────────────────── */
    .chain-gameover {
        display: none;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
        text-align: center;
        z-index: 20;
        position: fixed; 
        inset: 0; 
        background: #0a0a1a; 
        justify-content: center; 
        padding: 2rem; 
        overflow-y: auto;
    }

        .chain-gameover h2 {
            font-size: 2.5rem;
            font-weight: 700;
            color: #00e5ff;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin: 0;
            text-shadow: 0 0 30px rgba(0, 229, 255, 0.4);
        }
    /* ── High Score Banner ───────────────────────────────────────── */
    .hs-banner {
        width: 100%;
        max-width: 480px;
        padding: 1rem 1.5rem;
        border-radius: 8px;
        flex-direction: column;
        gap: 4px;
        text-align: center;
    }

    .hs-new {
        background: rgba(255,214,0,0.06);
        border: 1px solid rgba(255,214,0,0.3);
        animation: hsPulse 1s ease-in-out infinite alternate;
    }

    .hs-existing {
        background: rgba(0,229,255,0.04);
        border: 1px solid rgba(0,229,255,0.12);
    }

    @@keyframes hsPulse {
        from {
            box-shadow: 0 0 8px rgba(255,214,0,0.1);
        }

        to {
            box-shadow: 0 0 20px rgba(255,214,0,0.3);
        }
    }

    .hs-title {
        font-size: 0.9rem;
        font-weight: 700;
        color: #ffd600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .hs-existing .hs-title {
        color: #00e5ff;
    }

    .hs-sub {
        font-size: 0.7rem;
        color: #556677;
        letter-spacing: 0.05em;
    }

    .go-stat-grid {
        display: flex;
        gap: 1px;
        background: rgba(0, 229, 255, 0.1);
        border-radius: 8px;
        overflow: hidden;
        width: 100%;
        max-width: 540px;
        border: 1px solid rgba(0, 229, 255, 0.15);
    }

    .go-stat-cell {
        flex: 1;
        background: #0a0a1a;
        padding: 1.25rem 0.75rem;
    }

    .go-stat-val {
        font-size: 1.75rem;
        font-weight: 700;
        color: #00e5ff;
    }

    .go-stat-lbl {
        font-size: 0.65rem;
        color: #334455;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        margin-top: 4px;
    }

    .chain-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #00e5ff;
        color: #000;
        font-family: monospace;
        font-size: 0.9rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        padding: 0.9rem 2.5rem;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        text-decoration: none;
        box-shadow: 0 0 20px rgba(0, 229, 255, 0.25);
    }

    .chain-btn-ghost {
        background: transparent;
        color: #00e5ff;
        border: 1px solid rgba(0, 229, 255, 0.3);
        box-shadow: none;
    }

    .saving-indicator {
        font-size: 0.7rem;
        color: #445566;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        min-height: 18px;
    }

        .saving-indicator.saved {
            color: #00ff88;
        }

        .saving-indicator.error {
            color: #ff4466;
        }
</style>

<div class="chain-wrap">

    <!-- ── START OVERLAY ─────────────────────────────────────────────────── -->
    <div class="start-overlay" id="start-overlay">
        <div class="start-overlay-title">⛓ Chain Mode</div>
        <div class="start-overlay-sub">Link words. Keep the chain alive. Feel the beat.</div>

        <div class="start-overlay-rules">
            <div class="start-overlay-rule"><span>01 —</span> A word is shown — type it exactly and press Enter</div>
            <div class="start-overlay-rule"><span>02 —</span> Next word starts with the last letter of the previous</div>
            <div class="start-overlay-rule"><span>03 —</span> Press Enter close to the beat pulse for PERFECT</div>
            <div class="start-overlay-rule"><span>04 —</span> Miss 3 times and the chain breaks forever</div>
        </div>

        <div class="start-overlay-example">
            <span>APPLE</span> → <span>ECHO</span> → <span>ORBIT</span> → <span>TRUST</span>
        </div>

        <button class="start-overlay-btn" onclick="handleStart()">▶ Click to Start</button>
    </div>
    <!-- HUD -->
    <div class="chain-hud">
        <div class="hud-group">
            <div class="hud-item">
                <div class="hud-label">Score</div>
                <div class="hud-value" id="hud-score">0</div>
            </div>
            <div class="hud-item">
                <div class="hud-label">Chain</div>
                <div class="hud-value" id="hud-chain">0</div>
            </div>
            <div class="hud-item">
                <div class="hud-label">WPM</div>
                <div class="hud-value" id="hud-wpm">0</div>
            </div>
            <div class="hud-item">
                <div class="hud-label">BPM</div>
                <div class="hud-value" id="hud-bpm">80</div>
            </div>
        </div>
        <div class="chain-lives" id="lives-display"></div>
        <button id="mute-btn" onclick="toggleMute()">🔊</button>
    </div>

    <!-- Game Screen -->
    <div id="game-screen" style="display:flex; flex-direction:column; align-items:center; width:100%;">

        <div class="chain-trail" id="chain-trail"></div>

        <div class="chain-arena" id="chain-arena">
            <div class="chain-prompt" id="chain-prompt">type this word</div>
            <div class="chain-target-word" id="target-word">—</div>
            <div class="chain-last-hint" id="last-hint"></div>
            <div class="beat-bar-track">
                <div class="beat-bar-fill" id="beat-bar"></div>
            </div>
        </div>

        <div class="timing-zones">
            <div class="zone zone-perfect">⬛ Perfect ±120ms</div>
            <div class="zone zone-good">⬛ Good ±280ms</div>
            <div class="zone zone-late">⬛ Late</div>
        </div>

        <input class="chain-input"
               id="chain-input"
               type="text"
               autocomplete="off"
               autocorrect="off"
               autocapitalize="off"
               spellcheck="false"
               placeholder="TYPE HERE → ENTER" />

        <div class="chain-feedback" id="feedback"></div>
    </div>

    <!-- Game Over Screen -->
    <div class="chain-gameover" id="gameover-screen">
        <h2>Chain Broken</h2>
        <div class="go-stat-grid">
            <div class="go-stat-cell"><div class="go-stat-val" id="go-score">0</div><div class="go-stat-lbl">Score</div></div>
            <div class="go-stat-cell"><div class="go-stat-val" id="go-chain">0</div><div class="go-stat-lbl">Best Chain</div></div>
            <div class="go-stat-cell"><div class="go-stat-val" id="go-wpm">0</div><div class="go-stat-lbl">Best WPM</div></div>
            <div class="go-stat-cell"><div class="go-stat-val" id="go-words">0</div><div class="go-stat-lbl">Words</div></div>
            <div class="go-stat-cell"><div class="go-stat-val" id="go-perfects">0</div><div class="go-stat-lbl">Perfects</div></div>
        </div>

        <div id="highscore-banner" class="hs-banner" style="display:none;">
            <div id="hs-title" class="hs-title"></div>
            <div id="hs-sub" class="hs-sub"></div>
        </div>

        <div class="saving-indicator" id="saving-indicator"></div>
        <div style="display:flex; gap:1rem; flex-wrap:wrap; justify-content:center;">
            <button class="chain-btn" onclick="restartGame()">&#9658; Play again</button>
            <a class="chain-btn chain-btn-ghost" asp-action="Index">&#9632; Menu</a>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/chain-audio.js"></script>

    <script>
