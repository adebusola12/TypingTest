@{
    ViewData["Title"] = "Edit Profile";
}

<div style="max-width:500px; margin:3rem auto;">

    <div class="page-title">✎ Edit Profile</div>
    <div class="page-subtitle">// update your display name</div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="flash flash-error" style="position:relative; top:0; right:0; margin-bottom:1rem;">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>✗ @error.ErrorMessage</div>
            }
        </div>
    }

    <div class="card">
        <form method="post" asp-controller="Account" asp-action="EditProfile">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="form-label">Display Name</label>
                <input class="form-control"
                       type="text"
                       name="displayName"
                       value="@ViewBag.DisplayName"
                       maxlength="50"
                       placeholder="Enter your display name"
                       required />
            </div>
            <div style="display:flex; gap:1rem; margin-top:1.5rem;">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-controller="Account" asp-action="Profile" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>