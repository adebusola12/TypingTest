@model TypingTest.ViewModels.UserStatsViewModel
@{
    ViewData["Title"] = "Profile";
}

@section Styles {
    <style>
        .profile-wrap {
            max-width: 900px;
            margin: 2rem auto;
            padding: 0 1rem;
        }

        .profile-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 2rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .stat-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 1px;
            background: var(--border);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            overflow: hidden;
            margin-bottom: 2rem;
        }

        .stat-box {
            background: var(--surface);
            padding: 1.25rem;
            text-align: center;
        }

        .stat-value {
            font-family: var(--font-display);
            font-size: 1.5rem;
            font-weight: 900;
            color: var(--accent);
            margin-bottom: 4px;
        }

        .stat-label {
            font-family: var(--font-mono);
            font-size: 0.65rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--text3);
        }

        .recent-label {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--text3);
            margin-bottom: 1rem;
        }

        /* Mobile result cards */
        .result-cards {
            display: none;
        }

        @@media (max-width: 768px) {
            .stat-grid {
                grid-template-columns: repeat(3, 1fr);
            }

            .profile-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .result-table {
                display: none;
            }

            .result-cards {
                display: flex;
                flex-direction: column;
                gap: 0.75rem;
            }

            .result-card {
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: var(--radius-lg);
                padding: 1rem 1.25rem;
                display: grid;
                grid-template-columns: auto 1fr;
                gap: 1rem;
                align-items: center;
            }

            .result-card-wpm {
                font-family: var(--font-display);
                font-size: 2rem;
                font-weight: 900;
                color: var(--accent);
                text-align: center;
                min-width: 64px;
            }

            .result-card-wpm-label {
                font-family: var(--font-mono);
                font-size: 0.6rem;
                letter-spacing: 1px;
                color: var(--text3);
                text-align: center;
                text-transform: uppercase;
            }

            .result-card-info {
                display: flex;
                flex-direction: column;
                gap: 6px;
            }

            .result-card-top {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                flex-wrap: wrap;
            }

            .result-card-meta {
                font-family: var(--font-mono);
                font-size: 0.7rem;
                color: var(--text3);
                display: flex;
                gap: 0.75rem;
                flex-wrap: wrap;
            }

            .result-card-acc {
                color: var(--success);
            }

            .result-card-err {
                color: var(--danger);
            }
        }
    </style>
}

<div class="profile-wrap">
    <div style="font-family:var(--font-mono); font-size:0.85rem; color:var(--text3); letter-spacing:1px;">
        // welcome back
    </div>
    <div style="font-family:var(--font-display); font-size:1.5rem; font-weight:700; color:var(--accent); letter-spacing:2px; margin-bottom:2rem;">
        @Model.DisplayName
    </div>

    <!-- Header -->
    <div class="profile-header">
        <div>
            <div class="page-title">◉ @Model.DisplayName</div>
            <div class="page-subtitle">// your stats and history</div>
        </div>
        <a asp-controller="Account" asp-action="EditProfile" class="btn btn-secondary">✎ Edit Profile</a>
    </div>

    <!-- Stats grid -->
    <div class="stat-grid">
        <div class="stat-box">
            <div class="stat-value">@Model.BestWpm</div>
            <div class="stat-label">Best WPM</div>
        </div>
        <div class="stat-box">
            <div class="stat-value">@Model.AverageWpmDisplay</div>
            <div class="stat-label">Avg WPM</div>
        </div>
        <div class="stat-box">
            <div class="stat-value" style="color:var(--success)">@Model.AverageAccuracyDisplay</div>
            <div class="stat-label">Avg Accuracy</div>
        </div>
        <div class="stat-box">
            <div class="stat-value">@Model.TotalTestsTaken</div>
            <div class="stat-label">Tests Taken</div>
        </div>
        <div class="stat-box">
            <div class="stat-value" style="color:var(--warning)">#@Model.GlobalRank</div>
            <div class="stat-label">Global Rank</div>
        </div>
    </div>

    <!-- Recent results -->
    <div style="margin-top:2rem;">
        <div class="recent-label">Recent Results</div>

        @if (!Model.RecentResults.Any())
        {
            <div class="card" style="text-align:center; padding:2.5rem;">
                <div style="font-family:var(--font-mono); color:var(--text3); margin-bottom:1rem;">No tests yet. Start typing!</div>
                <a asp-controller="Test" asp-action="Index" class="btn btn-primary">▶ Start Test</a>
            </div>
        }
        else
        {
            <!-- Desktop table -->
            <div class="table-wrap result-table">
                <table>
                    <thead>
                        <tr>
                            <th>WPM</th>
                            <th>Accuracy</th>
                            <th>Errors</th>
                            <th>Difficulty</th>
                            <th>Mode</th>
                            <th>Passage</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.RecentResults)
                        {
                            <tr>
                                <td>
                                    <span style="font-family:var(--font-display); font-size:1.1rem; color:var(--accent); font-weight:700;">
                                        @r.Wpm
                                    </span>
                                </td>
                                <td style="color:var(--success)">@r.AccuracyDisplay</td>
                                <td style="color:var(--danger)">@r.ErrorCount</td>
                                <td>
                                    <span class="badge @(r.Difficulty == TypingTest.Models.DifficultyLevel.Easy ? "badge-easy" : r.Difficulty == TypingTest.Models.DifficultyLevel.Medium ? "badge-medium" : "badge-hard")">
                                        @r.Difficulty
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(r.Mode == TypingTest.Models.TestMode.Timed ? "badge-timed" : "badge-words")">
                                        @r.Mode
                                    </span>
                                </td>
                                <td style="color:var(--text2); font-size:0.8rem;">@r.PassageTitle</td>
                                <td style="color:var(--text3); font-size:0.8rem;">@r.CompletedAt.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile cards -->
            <div class="result-cards">
                @foreach (var r in Model.RecentResults)
                {
                    <div class="result-card">
                        <div>
                            <div class="result-card-wpm">@r.Wpm</div>
                            <div class="result-card-wpm-label">WPM</div>
                        </div>
                        <div class="result-card-info">
                            <div class="result-card-top">
                                <span class="badge @(r.Difficulty == TypingTest.Models.DifficultyLevel.Easy ? "badge-easy" : r.Difficulty == TypingTest.Models.DifficultyLevel.Medium ? "badge-medium" : "badge-hard")" style="font-size:10px; padding:2px 8px;">@r.Difficulty</span>
                                <span class="badge @(r.Mode == TypingTest.Models.TestMode.Timed ? "badge-timed" : "badge-words")" style="font-size:10px; padding:2px 8px;">@r.Mode</span>
                            </div>
                            <div class="result-card-meta">
                                <span class="result-card-acc">@r.AccuracyDisplay</span>
                                <span class="result-card-err">@r.ErrorCount errors</span>
                                <span>@r.PassageTitle</span>
                            </div>
                            <div style="font-family:var(--font-mono); font-size:0.7rem; color:var(--text3);">
                                @r.CompletedAt.ToString("MMM dd, yyyy")
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div style="text-align:center; margin-top:1rem;">
                <a asp-controller="Test" asp-action="History" class="btn btn-secondary">View Full History</a>
            </div>
        }
    </div>
</div>