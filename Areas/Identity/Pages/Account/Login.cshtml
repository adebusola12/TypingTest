@page
@model LoginModel
@{
    ViewData["Title"] = "Login"; Layout = "/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .auth-wrap {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 70vh;
            padding: 2rem 1rem;
        }

        .auth-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(0,255,200,0.15);
            border-radius: 8px;
            padding: 36px 40px;
            width: 100%;
            max-width: 440px;
            position: relative;
        }

            .auth-card::before, .auth-card::after {
                content: '';
                position: absolute;
                width: 12px;
                height: 12px;
                border-color: rgba(0,255,200,0.3);
                border-style: solid;
            }

            .auth-card::before {
                top: -1px;
                left: -1px;
                border-width: 1px 0 0 1px;
            }

            .auth-card::after {
                bottom: -1px;
                right: -1px;
                border-width: 0 1px 1px 0;
            }

        .auth-title {
            font-family: 'Orbitron',monospace;
            font-size: 22px;
            font-weight: 700;
            color: #fff;
            letter-spacing: 2px;
            margin-bottom: 4px;
        }

            .auth-title span {
                color: #00ffc8;
            }

        .auth-sub {
            font-family: 'JetBrains Mono',monospace;
            font-size: 12px;
            color: #555;
            letter-spacing: 1px;
            margin-bottom: 28px;
        }

        .auth-field {
            margin-bottom: 18px;
        }

            .auth-field label {
                display: block;
                font-family: 'JetBrains Mono',monospace;
                font-size: 11px;
                letter-spacing: 1.5px;
                color: #00ffc8;
                text-transform: uppercase;
                margin-bottom: 6px;
            }

        .auth-field-wrap {
            position: relative;
        }

        .auth-field input {
            width: 100%;
            padding: 11px 44px 11px 14px;
            background: rgba(0,0,0,0.4);
            border: 1px solid #222;
            border-radius: 4px;
            color: #e0e0e0;
            font-family: 'JetBrains Mono',monospace;
            font-size: 13px;
            outline: none;
            transition: border-color 0.2s;
        }

            .auth-field input:focus {
                border-color: rgba(0,255,200,0.4);
            }

            .auth-field input::placeholder {
                color: #333;
            }

        .auth-toggle {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #444;
            cursor: pointer;
            font-family: 'JetBrains Mono',monospace;
            font-size: 11px;
            letter-spacing: 1px;
        }

            .auth-toggle:hover {
                color: #00ffc8;
            }

        .auth-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 22px;
        }

        .auth-remember {
            display: flex;
            align-items: center;
            gap: 8px;
            font-family: 'JetBrains Mono',monospace;
            font-size: 12px;
            color: #555;
            cursor: pointer;
        }

            .auth-remember input {
                accent-color: #00ffc8;
            }

        .auth-forgot {
            font-family: 'JetBrains Mono',monospace;
            font-size: 11px;
            color: #444;
            text-decoration: none;
        }

            .auth-forgot:hover {
                color: #00ffc8;
            }

        .auth-btn {
            width: 100%;
            padding: 13px;
            background: transparent;
            border: 1px solid #00ffc8;
            color: #00ffc8;
            font-family: 'Orbitron',monospace;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 2px;
            cursor: pointer;
            border-radius: 4px;
            transition: all 0.2s;
        }

            .auth-btn:hover {
                background: rgba(0,255,200,0.08);
            }

        .auth-divider {
            text-align: center;
            font-family: 'JetBrains Mono',monospace;
            font-size: 11px;
            color: #333;
            letter-spacing: 1px;
            margin: 20px 0;
        }

        .auth-switch {
            text-align: center;
            font-family: 'JetBrains Mono',monospace;
            font-size: 12px;
            color: #444;
        }

            .auth-switch a {
                color: #00ffc8;
                text-decoration: none;
            }

        .auth-errors {
            margin-bottom: 16px;
        }

            .auth-errors li {
                font-family: 'JetBrains Mono',monospace;
                font-size: 12px;
                color: #ff4d4d;
                list-style: none;
                padding: 4px 0;
            }
    </style>
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-title">TYPE<span>X</span></div>
        <div class="auth-sub">// sign in to continue</div>

        <form method="post">
            <asp-validation-summary asp-validation-summary="ModelOnly" class="auth-errors"></asp-validation-summary>

            <div class="auth-field">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" placeholder="user@example.com" autocomplete="username" />
                <span asp-validation-for="Input.Email" style="font-size:11px;color:#ff4d4d;font-family:'JetBrains Mono',monospace;"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Input.Password">Password</label>
                <div class="auth-field-wrap">
                    <input asp-for="Input.Password" id="lpass" placeholder="••••••••" autocomplete="current-password" />
                    <button type="button" class="auth-toggle" onclick="togglePass('lpass',this)">SHOW</button>
                </div>
                <span asp-validation-for="Input.Password" style="font-size:11px;color:#ff4d4d;font-family:'JetBrains Mono',monospace;"></span>
            </div>

            <div class="auth-row">
                <label class="auth-remember">
                    <input asp-for="Input.RememberMe" type="checkbox" /> Remember me
                </label>
                <a class="auth-forgot" asp-page="./ForgotPassword">Forgot password?</a>
            </div>

            <button type="submit" class="auth-btn">[ SIGN IN ]</button>
        </form>

        <div class="auth-divider">── or ──</div>
        <div class="auth-switch">No account? <a asp-page="./Register">Register here</a></div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePass(id, btn) {
          const inp = document.getElementById(id);
          inp.type = inp.type === 'password' ? 'text' : 'password';
          btn.textContent = inp.type === 'password' ? 'SHOW' : 'HIDE';
        }
    </script>
}